<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- local-feed/ holds a PdfPecker package built from the library's main branch, for the time between a library change
       the packages need and its release (see RELEASING.md). It is git-ignored and usually empty. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="local-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="PdfPecker" />
    </packageSource>
  </packageSourceMapping>
</configuration>
